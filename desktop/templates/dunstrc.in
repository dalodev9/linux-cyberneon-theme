# Generated from templates/dunstrc.in by apply.sh
[global]
    monitor = 0
    follow = mouse
    origin = top-right
    width = (300, 420)
    height = 200
    notification_limit = 5
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    gap_size = 8
    separator_height = 0
    corner_radius = 0
    font = @FONT@ 11
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    icon_position = off
    show_age_threshold = 60
    sort = yes
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#@BG@"
    foreground = "#@MUTED@"
    frame_color = "#@CYAN@"
    timeout = 5

[urgency_normal]
    background = "#@BG@"
    foreground = "#@TEXT@"
    frame_color = "#@PINK@"
    timeout = 8

[urgency_critical]
    background = "#@BG@"
    foreground = "#@YELLOW@"
    frame_color = "#@YELLOW@"
    timeout = 0
